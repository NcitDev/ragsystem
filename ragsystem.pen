                  "gap": 1,
                  "padding": [
                    10,
                    16
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "MilAN",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "def _detect_git_changes(self, root: Path) -> set[Path]:",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "QMJdA",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    state = self._load_state(root)",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "x0CuN",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    head = subprocess.check_output(",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tAKS8",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "        [\"git\", \"rev-parse\", \"HEAD\"], cwd=root)",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "GlD4N",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    if state.head == head:",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fNfJy",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "        return set()",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "OOywA",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    changed = self._git_diff_files(state.head, head)",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "yeOdB",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    log.info(\"index.drift\", n=len(changed))",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "MRiiS",
                      "opacity": 0.18,
                      "fill": "$fg",
                      "content": "    return changed",
                      "fontFamily": "$mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },

# Copy this file to `.env` and fill in your keys, then restart the daemon:
#   cp .env.example .env   # then edit .env
#   rag start
#
# The daemon loads `.env` automatically (see src/rag/config.py:_load_env_files).
# `.env` is gitignored — never commit real keys.

# --- Retrieval agent (search-strategy planner) ---------------------------
# Which provider/key is used is controlled by [retrieval_agent] in
# config/default.toml (or ~/.rag/config.toml). The default provider is
# `gemini`, which reads GEMINI_API_KEY. Set the key for whichever provider
# you configured.

# Google Gemini  (provider = "gemini")
GEMINI_API_KEY=

# OpenAI         (provider = "openai")
# OPENAI_API_KEY=

# Anthropic      (provider = "anthropic")
# ANTHROPIC_API_KEY=

# Ollama needs no key (provider = "ollama", local).

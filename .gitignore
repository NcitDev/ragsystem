/target/
ragsystem_benchmarked.zip
*.zip
tmp_serena/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Claude
.claude/plans/

# Benchmark / vocab experiment artifacts (results live in docs/ or bench/)
/vocab_*.jsonl
/*_run.log
/benchmark_*_results.json
/graphify-out/
/*_list.txt

# IDE/tool metadata that regenerates itself
.qoder/

# Daemon/runtime markers (not project state)
.qdrant-initialized
.claude/scheduled_tasks.lock

# Large local artifacts (kept on disk, out of git)
ragsystem.pen
